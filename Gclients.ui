     <string notr="true">#label_5c{/* Labels spéciaux */
    border:none;
    background-color: transparent;
    font-weight: 700;
color: rgb(66, 157, 255);
font: 25pt &quot;Imprint MT Shadow&quot;;
}
QPushButton {
    border-radius: 20px;
background-color: rgba(0, 0, 150, 0.7); 
   border: 2px solid #59abc8; 
 color: white;
    font-weight: 700;
    font-size: 15px;
    margin-bottom:20px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
padding: 10px 20px;
}
QComboBox,QSpinBox,QDateEdit {
    font-size: 16px;
    padding: 6px;
    border: 2px solid #59abc8;
    border-radius: 15px;
	background-color: rgba(0, 0, 50, 0.8); 
}
QPushButton:hover {
    transform: translateY(-2px);
    color: #59abc8;
}
#label_9c,#label_14c,#label_15c,#label_11c,#label_12c,#label_18c,#label_3c{border:none;
font-size: 15px;   
    padding: 1px;
background-color:transparent;}
QFrame {
     border-radius: 15px;
 		background-color: rgba(0, 0, 50, 0.7); 


    border: 2px solid #59abc8 ; 
}

#lineEdit{
border: 2px solid #59abc8 ; 
	background-color: rgba(0, 0, 50, 0.7); }
QLineEdit{
font-size: 17px;
    background: transparent;  
    border: none;
    color: white;
    border-bottom: 2px solid #59abc8; 
    padding: 3px;
 selection-background-color: white; 
   
}
QLineEdit:focus {

    color: #59abc8;
} 
#pagec{background-image: url(:/new/prefix1/bg.png);
 background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
border-radius:15px;}
/* TableWidget */
QTableWidget {
    background-color: rgba(0, 0, 50, 0.7);
    border: 2px solid #59abc8;
    border-radius: 15px;
    gridline-color: #59abc8;
    color: white;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid rgba(89, 171, 200, 0.3);
}

QTableWidget::item:selected {
    background-color: #0078D7;
}

QHeaderView::section {
    background-color: rgba(0, 40, 80, 0.9);
    color: white;
    padding: 8px;
    border-radius: 5px;
    border: 1px solid #59abc8;
}

