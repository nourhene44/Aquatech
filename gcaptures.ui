QTableWidget {
    background-color: rgba(0, 0, 50, 0.7);
    border: 2px solid #59abc8;
    border-radius: 15px;
    gridline-color: #59abc8;
    color: white;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid rgba(89, 171, 200, 0.3);
}

QTableWidget::item:selected {
    background-color: #0078D7;
}

QHeaderView::section {
    background-color: rgba(0, 40, 80, 0.9);
    color: white;
    padding: 8px;
    border-radius: 5px;
    border: 1px solid #59abc8;
}

/* IMPORTANT : Avec QMainWindow, on stylise centralwidget */
#centralwidget {
    background-image: url(:/image/bg.png);
    background-position: center;
    background-size: cover;
    border-radius:15px;
}

#lblTitle{
    border:none;
    background-color: transparent;
    font-weight: 700;
    color: rgb(66, 157, 255);
    font: 25pt &quot;Imprint MT Shadow&quot;;
}

#label,#label_2,#label_3,#label_4,#label_10,#label_11{
    border:none;
    background-color:transparent;
    font-size: 15px;
    padding: 1px;
}

#labelLeftTitle{
    color:#fffae0;
    font-weight: 600;
    font-size: 17px;
    padding: 5px 0;
}

#label_2b,#label_4b,#label_8b,#label_13b{
    background-color:transparent;
    border-image: url(:/image/login.png);
}

QLabel{
    font-family: 'Arial';
    color:white;
}

QFrame {
    border-radius: 15px;
    background-color: rgba(0, 0, 50, 0.7);
    border: 2px solid #59abc8 ;
}

QPushButton {
    border-radius: 20px;
    background-color: rgba(0, 0, 150, 0.7);
    border: 2px solid #59abc8;
    color: white;
    font-weight: 700;
    font-size: 15px;
    margin-bottom:20px;
    padding: 10px 20px;
}

QPushButton:hover {
    color: #59abc8;
}

QLineEdit{
    font-size: 17px;
    background: transparent;
    border: none;
    color: white;
    border-bottom: 2px solid #59abc8;
    padding: 3px;
    selection-background-color: white;
}

QLineEdit:focus {
    color: #59abc8;
}

*{
  font-family: &quot;Segoe UI&quot;, &quot;Century Gothic&quot;, sans-serif;
  font-size: 14px;
  font-weight: 400;
}
