    border-radius: 10px;
    padding: 6px 12px;
    color: white;
    font-weight: 600;
}

#btnRefreshStats_2:hover {
  background-color: rgba(0, 0, 127,0.7);
    border-color: rgba(255, 140, 0, 0.9);
}

#comboChartType_2 {
 background-color: rgba(0, 0, 127,0.7);
    border: 1px solid rgba(52, 152, 219, 0.9);
    border-radius: 10px;
    color: white;
    padding: 5px 10px;
    min-height: 24px;
    font-size: 11px;
}

#comboChartType_2::drop-down {
    border: none;
    width: 22px;
}

#comboChartType_2 QAbstractItemView {
   background-color: rgb(224, 238, 255);
    color: white;
    border: 1px solid rgba(52, 152, 219, 0.9);
    selection-background-color: rgba(52, 152, 219, 0.55);
}

#curveCanvas_2 {
   background-color: rgb(224, 238, 255);
    border-radius: 14px;
    border: 1px solid rgba(52, 73, 94, 0.95);
}

#label_chartXAxis_2 {
    color: #95a5a6;
    font-size: 9px;
}

#legendNord_2 { color: #3498db; font-weight: 700; font-size: 10px; }
#legendSud_2  { color: #27ae60; font-weight: 700; font-size: 10px; }
#legendEst_2  { color: #f39c12; font-weight: 700; font-size: 10px; }
#legendOuest_2{ color: #9b59b6; font-weight: 700; font-size: 10px; }</string>
