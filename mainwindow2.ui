}
QFrame {
     border-radius: 15px;
 		background-color: rgba(0, 0, 50, 0.7); 


    border: 2px solid #59abc8 ; 
}
QPushButton {
    border-radius: 15px;
background-color: rgba(0, 0, 150, 0.7); 
 color: white;
   border: 2px solid #59abc8;  /* إطار أزرق غامق */
    font-weight: 700;
    font-size: 15px;
    margin-bottom:20px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
padding: 10px 20px;
}
QPushButton:hover {
    transform: translateY(-2px);
    color: #59abc8;
}

QLineEdit{
font-size: 17px;
    background: transparent;  
    border: none;
    color: white;
    border-bottom: 2px solid #59abc8; 
    padding: 3px;
 selection-background-color: white; 
   
}
QLineEdit:focus {

    color: #59abc8;
}
