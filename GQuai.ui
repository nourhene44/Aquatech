    <property name="styleSheet">
     <string notr="true">

/* Pages avec fond d'écran */
#page_3, #page_4 {
    background-image: url(:/res/bg.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 15px;
    font: 9px &quot;Arial&quot;;
}

/* ComboBox */
QComboBox {
    font-size: 14px;
    padding: 6px;
    border: 2px solid #59abc8;
    border-radius: 15px;
    background-color: rgba(0, 0, 50, 0.8);
    color: white;
    min-height: 20px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(:/down_arrow.png);
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background-color: rgba(0, 0, 50, 0.9);
    color: white;
    border: 2px solid #59abc8;
    selection-background-color: #0078D7;
}

/* LineEdit */
QLineEdit {
    font-size: 17px;
    background: transparent;
    border: none;
    color: white;
    border-bottom: 2px solid #0078D7;
    padding: 3px;
    selection-background-color: #FF8C00;
}

QLineEdit:focus {
    border-bottom: 2px solid #FF8C00;
font: &quot;Arial&quot;;
color:rgb(187, 226, 255);
}

/* Boutons spéciaux */
#ba, #bm, #bs, #br, #be, #btr, #brm, #bstat {
    border-radius: 15px;
    background-color: rgba(0, 0, 50, 0.8);
    border: 2px solid #59abc8;
    color: white;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
font:  &quot;Arial&quot;;
}

#ba:hover, #bm:hover, #bs:hover, #br:hover, #be:hover, #btr:hover, #brm:hover, #bstat:hover {
    background-color: rgba(89, 171, 200, 0.3);
    border-color: #FF8C00;
}

/* Labels spéciaux */
#label_3{
    border:none;
    background-color: transparent;
    font-weight: 700;
color: rgb(66, 157, 255);
font: 25pt &quot;Imprint MT Shadow&quot;;
}

#label_2, #label3_6,#label3_7,#label3_10,#label3_8,#label3_9 {
    border: none;
    background-color: transparent;
    color: #ffffff;
font: 15px &quot;Arial&quot;;
}

/* Frame */
QFrame {
    border-radius: 15px;
    background-color: rgba(0, 0, 50, 0.7);
    border: 2px solid #59abc8;
font: 15px &quot;Arial&quot;;
}

/* Frame avec logo */
#frame1 {
    image: url(:/logoqt.jpg);
    background-color: transparent;
    border: none;
}



/* Boutons généraux */
QPushButton {
    background-color: rgba(0, 40, 80, 0.8);
    border: 1px solid #59abc8;
    border-radius: 15px;
    color: white;
    padding: 8px 16px;
    font-size: 15px;
font:  &quot;Arial&quot;;
}

QPushButton:hover {
    background-color: rgba(0, 120, 215, 0.6);
    border-color: #FF8C00;
}

QPushButton:pressed {
    background-color: rgba(0, 120, 215, 0.8);
}

/* SpinBox et DoubleSpinBox */
QSpinBox, QDoubleSpinBox {
    background-color: rgba(0, 0, 50, 0.8);
    border: 2px solid #59abc8;
    border-radius: 15px;
    color: white;
    padding: 3px;
    min-height: 25px;
font: 9pt &quot;Arial&quot;;
}

/* TableWidget */
QTableWidget {
    background-color: rgba(0, 0, 50, 0.7);
    border: 2px solid #59abc8;
    border-radius: 15px;
    gridline-color: #59abc8;
    color: white;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid rgba(89, 171, 200, 0.3);
}

QTableWidget::item:selected {
    background-color: #0078D7;
font: 9pt &quot;Arial&quot;;
}

QHeaderView::section {
    background-color: rgba(0, 40, 80, 0.9);
    color: white;
    padding: 8px;
    border-radius: 5px;
    border: 1px solid #59abc8;
font: 8pt &quot;Arial&quot;;
}

/* MenuBar */
QMenuBar {
    background-color: rgba(0, 0, 50, 0.9);
    color: white;
    border-bottom: 2px solid #59abc8;
font: 9pt &quot;Arial&quot;;
}

QMenuBar::item:selected {
    background-color: #0078D7;
font: 9pt &quot;Arial&quot;;
}

/* StatusBar */
QStatusBar {
    background-color: rgba(0, 0, 50, 0.9);
    color: white;
    border-top: 1px solid #59abc8;
font: 9pt &quot;Arial&quot;;
}

/* ToolBar */
QToolBar {
    background-color: rgba(0, 0, 50, 0.8);
    border: 1px solid #59abc8;
    spacing: 5px;
    padding: 3px;
font: 9pt &quot;Arial&quot;;
}

/* === NOUVEAUX STYLES POUR LA SECTION COMPATIBILITÉ === */
#frameCompatibilite {
    border-radius: 15px;
    background-color: rgba(0, 30, 60, 0.8);
    border: 2px solid #59abc8;
    padding: 10px;
font: 9pt &quot;Arial&quot;;
}

#tableCompatibilite {
    background-color: rgba(0, 20, 40, 0.9);
    border: 1px solid #34495e;
    border-radius: 10px;
    gridline-color: #59abc8;
    color: white;
    font-size: 12px;
}

#tableCompatibilite::item {
    padding: 5px;
    border-bottom: 1px solid rgba(89, 171, 200, 0.2);
}

#tableCompatibilite::item:selected {
    background-color: rgba(89, 171, 200, 0.4);
}

#tableCompatibilite QHeaderView::section {
    background-color: rgba(0, 40, 80, 0.9);
    color: white;
    padding: 6px;
    border: 1px solid #59abc8;
    font-weight: bold;
    font-size: 11px;
}

#btnAnalyserIA {
    border-radius: 15px;
    background-color: rgba(46, 204, 113, 0.8);
    border: 2px solid #27ae60;
    color: white;
    padding: 8px;
    font-size: 14px;
    font-weight: 600;
}

#btnAnalyserIA:hover {
    background-color: rgba(39, 174, 96, 0.9);
    border-color: #2ECC71;
}

#btnAttribuerAuto {
    border-radius: 15px;
    background-color: rgba(52, 152, 219, 0.8);
    border: 2px solid #2980b9;
    color: white;
    padding: 8px;
    font-size: 14px;
    font-weight: 600;
font: 9pt &quot;Arial&quot;;
}

#btnAttribuerAuto:hover {
    background-color: rgba(41, 128, 185, 0.9);
    border-color: #3498db;
font: 9pt &quot;Arial&quot;;
}</string>
